<%- include('../partials/header') %>
<div class="cab">
  <div class="cab-txt">
    <div class="migalha"><a href="/empresas">Empresas</a> <%- ic('direita', 12) %> <a href="/empresas/<%= emp.id %>?aba=tomadores"><%= emp.razao_social %></a> <%- ic('direita', 12) %> <span><%= tom.id ? 'Editar tomador' : 'Novo tomador' %></span></div>
    <h1><%= titulo %></h1>
    <p class="subtitulo">Cliente de <%= emp.razao_social %> que recebe as notas.</p>
  </div>
</div>
<form method="post" action="/empresas/<%= emp.id %>/tomadores<%= tom.id ? '/' + tom.id : '' %>" data-validar style="max-width:920px">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <input type="hidden" name="voltar" value="<%= voltar %>">
  <%- include('../partials/form-tomador', { tom }) %>
  <div class="acoes">
    <button class="btn btn-pri"><%- ic('check') %><%- ic('carregando', 16, 'giro') %> Salvar tomador</button>
    <a class="btn btn-fantasma" href="/empresas/<%= emp.id %>?aba=tomadores">Cancelar</a>
  </div>
</form>
<%- include('../partials/footer') %>
