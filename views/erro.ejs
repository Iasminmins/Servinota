<% if (user) { %>
<%- include('partials/header') %>
<div class="card" style="max-width:560px;margin:40px auto">
  <div class="vazio">
    <div class="vazio-ic" style="color:var(--erro);background:var(--erro-bg);border-color:var(--erro-borda)"><%- ic('alerta', 22) %></div>
    <h3><%= titulo %></h3>
    <p><%= msg %></p>
    <% if (typeof detalhe !== 'undefined' && detalhe) { %><p><code><%= detalhe %></code></p><% } %>
    <div class="flex" style="justify-content:center">
      <a class="btn" href="javascript:history.back()"><%- ic('esquerda') %> Voltar</a>
      <a class="btn btn-pri" href="<%= user.papel === 'cliente' ? '/portal' : '/' %>">Ir para o início</a>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
<% } else { %>
<!doctype html>
<html lang="pt-BR"><head><%- include('partials/head') %></head>
<body>
<div class="auth-form" style="min-height:100vh;background:var(--fundo)">
  <div class="card" style="max-width:440px;width:100%">
    <div class="vazio">
      <div class="vazio-ic"><%- ic('alerta', 22) %></div>
      <h3><%= titulo %></h3>
      <p><%= msg %></p>
      <a class="btn btn-pri" href="/login">Ir para o login</a>
    </div>
  </div>
</div>
</body></html>
<% } %>
