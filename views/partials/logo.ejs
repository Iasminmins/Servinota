<a href="<%= typeof href !== 'undefined' ? href : '/' %>" class="logo" aria-label="Servinota - início">
  <svg width="30" height="30" viewBox="0 0 32 32" aria-hidden="true">
    <defs><linearGradient id="lg-<%= typeof idLogo !== 'undefined' ? idLogo : 'a' %>" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#14b8a6"/><stop offset="1" stop-color="#0f766e"/></linearGradient></defs>
    <rect width="32" height="32" rx="8" fill="url(#lg-<%= typeof idLogo !== 'undefined' ? idLogo : 'a' %>)"/>
    <path d="M10 7.5h8.2l4.3 4.3V23a1.5 1.5 0 0 1-1.5 1.5H10A1.5 1.5 0 0 1 8.5 23V9A1.5 1.5 0 0 1 10 7.5Z" fill="#fff"/>
    <path d="M18 7.5v3.2c0 .7.6 1.3 1.3 1.3h3.2" fill="#99f6e4"/>
    <path d="m12 17.6 2.4 2.4 4.6-4.8" fill="none" stroke="#0f766e" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
  <span class="logo-txt">Servinota<% if (typeof subLogo !== 'undefined' && subLogo) { %><small><%= subLogo %></small><% } %></span>
</a>
