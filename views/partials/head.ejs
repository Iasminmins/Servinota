<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= typeof titulo !== 'undefined' ? titulo + ' · ' : '' %>Servinota</title>
<link rel="icon" type="image/svg+xml" href="/img/favicon.svg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">
<link rel="stylesheet" href="/css/style.css?v=2">
<script>
  // aplica tema e estado da sidebar antes de pintar a tela (evita piscar)
  (function () {
    var d = document.documentElement, t = null, l = null;
    try { t = localStorage.getItem('tema'); l = localStorage.getItem('lateral'); } catch (e) {}
    if (t === 'escuro' || (!t && window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches)) d.setAttribute('data-tema', 'escuro');
    if (l === 'recolhida') d.classList.add('lateral-recolhida');
  })();
</script>
