<%- include('partials/header') %>
<%
  const tipos = {
    nota_emitida: ['ok', 'cor-ok', 'Nota emitida'], nota_erro: ['erro', 'cor-erro', 'Erro na emissão'], nota_criada: ['emitir', 'cor-pri', 'Nota enviada'],
    nota_cancelada: ['cancelar', 'cor-aviso', 'Nota cancelada'], nota_email: ['email', 'cor-info', 'E-mail enviado'], nota_reenviada: ['reenviar', 'cor-info', 'Reenvio'],
    nota_excluida: ['lixo', 'cor-erro', 'Nota excluída'], nota_portal: ['globo', 'cor-pri', 'Emissão pelo portal'], login: ['usuario', 'cor-neutra', 'Login'],
    importacao: ['upload', 'cor-pri', 'Importação'], certificado_enviado: ['escudo', 'cor-ok', 'Certificado enviado'], certificado_removido: ['escudo', 'cor-aviso', 'Certificado removido'],
  };
%>
<div class="cab">
  <div class="cab-txt">
    <h1>Histórico</h1>
    <p class="subtitulo">Tudo o que aconteceu no escritório. Mostrando os últimos 300 registros.</p>
  </div>
</div>
<div class="card">
  <% if (!logs.length) { %>
    <%- include('partials/vazio', { icone: 'historico', tituloVazio: 'Nada registrado ainda', texto: 'As ações da equipe e do sistema aparecem aqui.' }) %>
  <% } else { %>
  <ul class="lista-itens">
    <% logs.forEach(l => { const t = tipos[l.acao] || ['historico', 'cor-neutra', l.acao.replace(/_/g, ' ')]; %>
      <li style="align-items:flex-start">
        <span class="metrica-ic <%= t[1] %>" style="width:32px;height:32px;margin-top:2px"><%- ic(t[0], 15) %></span>
        <div class="li-txt">
          <strong style="white-space:normal"><%= t[2].charAt(0).toUpperCase() + t[2].slice(1) %></strong>
          <% if (l.detalhe) { %><small style="white-space:normal;color:var(--texto-2);font-size:13px"><%= l.detalhe %></small><% } %>
          <small><%= l.usuario || 'Sistema' %> · <%= u.fmtData(l.criado_em) %></small>
        </div>
      </li>
    <% }) %>
  </ul>
  <% } %>
</div>
<%- include('partials/footer') %>
