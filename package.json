  "description": "Servinota — Emissão e gestão de NFS-e para escritórios contábeis.",
  "private": true,
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning src/server.js",
